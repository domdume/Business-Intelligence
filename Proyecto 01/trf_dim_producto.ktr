    <connection>favorita_db</connection>
    <sql>SELECT DISTINCT TRIM(family) AS family, MAX(perishable) AS perishable FROM staging.stg_items GROUP BY TRIM(family) ORDER BY family;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
