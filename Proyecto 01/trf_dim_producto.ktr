  <step>
    <name>User defined Java expression</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>category</field_name>
      <formula_string>(family.equals("GROCERY I") || family.equals("GROCERY II") || family.equals("BREAD/BAKERY") || family.equals("FROZEN FOODS") || family.equals("PREPARED FOODS")) ? "Alimentos basicos" : (family.equals("BEVERAGES") || family.equals("LIQUOR,WINE,BEER")) ? "Bebidas" : (family.equals("DAIRY") || family.equals("EGGS") || family.equals("MEATS") || family.equals("POULTRY") || family.equals("SEAFOOD") || family.equals("DELI") || family.equals("PRODUCE")) ? "Frescos y perecederos" : (family.equals("CLEANING") || family.equals("HOME CARE") || family.equals("PERSONAL CARE") || family.equals("BEAUTY") || family.equals("BABY CARE")) ? "Cuidado y limpieza" : (family.equals("HOME AND KITCHEN I") || family.equals("HOME AND KITCHEN II") || family.equals("HOME APPLIANCES") || family.equals("LAWN AND GARDEN") || family.equals("HARDWARE")) ? "Hogar y electrodomesticos" : (family.equals("LADIESWEAR") || family.equals("LINGERIE") || family.equals("CELEBRATION")) ? "Moda y celebracion" : "Otros"</formula_string>
      <value_type>String</value_type>
      <value_length>30</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>perishable_label</field_name>
      <formula_string>perishable == 1 ? "Perecedero" : "No perecedero"</formula_string>
      <value_type>String</value_type>
      <value_length>15</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
